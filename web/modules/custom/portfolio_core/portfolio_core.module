<?php

/**
 * @file
 * Hooks for the Portfolio Core module: JSON-LD, preprocess and views.
 */

declare(strict_types=1);

/**
 * @file
 * Primary module hooks for Portfolio Core.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;
use Drupal\Core\Url;
use Drupal\views\Plugin\views\cache\CachePluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_page_attachments().
 */
function portfolio_core_page_attachments(array &$attachments): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface) {
    return;
  }

  $json_ld = NULL;
  /** @var \Drupal\portfolio_core\Service\ProfileDataService $profile_data */
  $profile_data = \Drupal::service('portfolio_core.profile_data');

  if ($node->bundle() === 'profile') {
    $github   = $node->get('field_github_url');
    $linkedin = $node->get('field_linkedin_url');
    $sameAs   = [];
    if (!$github->isEmpty()) {
      $sameAs[] = $github->first()->getUrl()->toString();
    }
    if (!$linkedin->isEmpty()) {
      $sameAs[] = $linkedin->first()->getUrl()->toString();
    }

    $thumbnail_url = $profile_data->fileUrl($node, 'field_thumbnail');

    $json_ld = array_filter([
      '@context'   => 'https://schema.org',
      '@type'      => 'Person',
      'name'       => $node->label(),
      'jobTitle'   => $node->get('field_subtitle')->value ?? '',
      'email'      => $node->get('field_email')->value ?? '',
      'url'        => Url::fromRoute('<front>')->setAbsolute()->toString(),
      'image'      => $thumbnail_url ?: NULL,
      'description' => strip_tags($node->get('field_bio')->value ?? ''),
      'sameAs'     => $sameAs ?: NULL,
    ]);
  }

  if ($node->bundle() === 'project') {
    $demo      = $node->get('field_demo_url');
    $repo      = $node->get('field_repo_url');
    $stack     = array_map(fn($t) => $t->label(), $node->get('field_stack')->referencedEntities());
    $thumbnail = $profile_data->fileUrl($node, 'field_thumbnail');

    $json_ld = array_filter([
      '@context'          => 'https://schema.org',
      '@type'             => 'SoftwareSourceCode',
      'name'              => $node->label(),
      'description'       => $node->get('field_summary')->value ?? '',
      'url'               => $node->toUrl()->setAbsolute()->toString(),
      'image'             => $thumbnail ?: NULL,
      'codeRepository'    => !$repo->isEmpty() ? $repo->first()->getUrl()->toString() : NULL,
      'runtimePlatform'   => !$demo->isEmpty() ? $demo->first()->getUrl()->toString() : NULL,
      'programmingLanguage' => $stack ?: NULL,
      'author'            => ['@type' => 'Person', 'name' => $node->getOwner()->getDisplayName()],
    ]);
  }

  if ($node->bundle() === 'article') {
    $tags     = array_map(fn($t) => $t->label(), $node->get('field_tags')->referencedEntities());
    $hero_url = $profile_data->fileUrl($node, 'field_hero_image');
    $site_url = Url::fromRoute('<front>')->setAbsolute()->toString();

    $json_ld = array_filter([
      '@context'       => 'https://schema.org',
      '@type'          => 'TechArticle',
      'headline'       => $node->label(),
      'description'    => $node->get('field_summary')->value ?? '',
      'datePublished'  => date('c', (int) $node->getCreatedTime()),
      'dateModified'   => date('c', (int) $node->getChangedTime()),
      'url'            => $node->toUrl()->setAbsolute()->toString(),
      'image'          => $hero_url ?: NULL,
      'keywords'       => $tags ?: NULL,
      'author'         => ['@type' => 'Person', 'name' => $node->getOwner()->getDisplayName()],
      'publisher'      => ['@type' => 'Person', 'name' => $node->getOwner()->getDisplayName(), 'url' => $site_url],
    ]);
  }

  if ($json_ld) {
    $attachments['#attached']['html_head'][] = [
      [
        '#type'       => 'html_tag',
        '#tag'        => 'script',
        '#value'      => json_encode($json_ld, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_AMP | JSON_HEX_TAG),
        '#attributes' => ['type' => 'application/ld+json'],
      ],
      'portfolio-json-ld',
    ];
  }

  // WebSite schema on the front page (the profile), linked to the Person.
  if ($node->bundle() === 'profile' && \Drupal::service('path.matcher')->isFrontPage()) {
    $site_url = Url::fromRoute('<front>')->setAbsolute()->toString();
    $website = array_filter([
      '@context'    => 'https://schema.org',
      '@type'       => 'WebSite',
      'name'        => $node->label(),
      'url'         => $site_url,
      'description' => \Drupal::config('system.site')->get('slogan') ?: NULL,
      'inLanguage'  => \Drupal::languageManager()->getCurrentLanguage()->getId(),
      'author'      => ['@type' => 'Person', 'name' => $node->label(), 'url' => $site_url],
    ]);
    $attachments['#attached']['html_head'][] = [
      [
        '#type'       => 'html_tag',
        '#tag'        => 'script',
        '#value'      => json_encode($website, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_AMP | JSON_HEX_TAG),
        '#attributes' => ['type' => 'application/ld+json'],
      ],
      'portfolio-json-ld-website',
    ];
  }
}

/**
 * Implements hook_ENTITY_TYPE_build_defaults_alter() for node entities.
 *
 * While a tailored CV is rendered, the profile's PDF build must not come from
 * (or go into) the render cache, or the public CV and the tailored one would
 * be served in place of each other.
 */
function portfolio_core_node_build_defaults_alter(array &$build, EntityInterface $entity, string $view_mode): void {
  if ($entity->bundle() === 'profile'
    && \Drupal::service('portfolio_core.tailored_cv_context')->get() !== NULL) {
    unset($build['#cache']['keys']);
    $build['#cache']['max-age'] = 0;
  }
}

/**
 * Implements hook_preprocess_node().
 */
function portfolio_core_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $view_mode = $variables['view_mode'];

  if ($view_mode === 'teaser') {
    match ($node->bundle()) {
      'project'      => _portfolio_core_preprocess_project_teaser($variables, $node),
      'article'      => _portfolio_core_preprocess_article_teaser($variables, $node),
      'feature_demo' => _portfolio_core_preprocess_feature_demo_teaser($variables, $node),
      'skill'        => _portfolio_core_preprocess_skill_teaser($variables, $node),
      default        => NULL,
    };
    return;
  }

  if ($view_mode === 'full') {
    match ($node->bundle()) {
      'project' => _portfolio_core_preprocess_project_full($variables, $node),
      'profile' => _portfolio_core_preprocess_profile_full($variables, $node),
      'article' => _portfolio_core_preprocess_article_full($variables, $node),
      default   => NULL,
    };
    return;
  }

  if ($view_mode === 'pdf') {
    match ($node->bundle()) {
      'profile' => _portfolio_core_preprocess_profile_pdf($variables, $node),
      default   => NULL,
    };
  }
}

/**
 * Prepares variables for project teaser template.
 */
function _portfolio_core_preprocess_project_teaser(array &$variables, NodeInterface $node): void {
  $stack_terms = $node->get('field_stack')->referencedEntities();
  $variables['project_stack'] = array_map(fn($t) => $t->label(), $stack_terms);

  $status_terms = $node->get('field_status')->referencedEntities();
  $variables['project_status'] = !empty($status_terms) ? $status_terms[0]->label() : '';

  $thumbnail = $node->get('field_thumbnail');
  $variables['project_thumbnail_url'] = !$thumbnail->isEmpty()
    ? \Drupal::service('file_url_generator')->generateAbsoluteString($thumbnail->entity->getFileUri())
    : '';

  $demo_url = $node->get('field_demo_url');
  $variables['project_demo_url'] = !$demo_url->isEmpty()
    ? $demo_url->first()->getUrl()->toString()
    : '';

  $repo_url = $node->get('field_repo_url');
  $variables['project_repo_url'] = !$repo_url->isEmpty()
    ? $repo_url->first()->getUrl()->toString()
    : '';

  $variables['project_path'] = $node->toUrl()->toString();
  $variables['project_summary'] = $node->get('field_summary')->value ?? '';
}

/**
 * Prepares variables for skill teaser template.
 */
function _portfolio_core_preprocess_skill_teaser(array &$variables, NodeInterface $node): void {
  $category_terms = $node->get('field_category')->referencedEntities();
  $variables['skill_category'] = !empty($category_terms) ? $category_terms[0]->label() : '';
  $variables['skill_level'] = (int) $node->get('field_skill_level')->value;
  $variables['skill_icon_class'] = $node->get('field_icon_class')->value ?? '';
}

/**
 * Prepares variables for article teaser template.
 */
function _portfolio_core_preprocess_article_teaser(array &$variables, NodeInterface $node): void {
  $tag_terms = $node->get('field_tags')->referencedEntities();
  $variables['article_tags'] = array_map(fn($t) => $t->label(), $tag_terms);

  $hero = $node->get('field_hero_image');
  $variables['article_hero_url'] = !$hero->isEmpty()
    ? \Drupal::service('file_url_generator')->generateAbsoluteString($hero->entity->getFileUri())
    : '';

  $variables['article_path'] = $node->toUrl()->toString();
  $variables['article_summary'] = $node->get('field_summary')->value ?? '';
  $variables['article_date'] = \Drupal::service('date.formatter')
    ->format($node->getCreatedTime(), 'medium');
}

/**
 * Prepares variables for feature_demo teaser template.
 */
function _portfolio_core_preprocess_feature_demo_teaser(array &$variables, NodeInterface $node): void {
  $variables['feature_pattern'] = $node->get('field_drupal_pattern')->value ?? '';
  $variables['feature_difficulty'] = $node->get('field_difficulty')->value ?? '';
  $variables['feature_path'] = $node->toUrl()->toString();
}

/**
 * Prepares variables for article full template.
 */
function _portfolio_core_preprocess_article_full(array &$variables, NodeInterface $node): void {
  $date_formatter = \Drupal::service('date.formatter');

  $variables['article_summary'] = $node->get('field_summary')->value ?? '';
  $variables['article_date'] = $date_formatter->format($node->getCreatedTime(), 'custom', 'F j, Y');

  $tag_terms = $node->get('field_tags')->referencedEntities();
  $variables['article_tags'] = array_map(fn($t) => $t->label(), $tag_terms);

  $stack_terms = $node->get('field_stack')->referencedEntities();
  $variables['article_stack'] = array_map(fn($t) => $t->label(), $stack_terms);

  $hero = $node->get('field_hero_image');
  $variables['article_hero_url'] = !$hero->isEmpty()
    ? \Drupal::service('file_url_generator')->generateAbsoluteString($hero->entity->getFileUri())
    : '';

  // Collect text for reading time: summary, body, and any paragraphs.
  $text = $node->get('field_summary')->value ?? '';
  $body = $node->get('body');
  if (!$body->isEmpty()) {
    $text .= ' ' . ($body->value ?? '');
  }
  foreach ($node->get('field_content')->referencedEntities() as $paragraph) {
    foreach ($paragraph->getFields() as $field) {
      $definition = $field->getFieldDefinition();
      if (in_array($definition->getType(), ['text', 'text_long', 'text_with_summary', 'string_long'])) {
        $text .= ' ' . ($field->value ?? '');
      }
    }
  }
  $variables['article_reading_text'] = strip_tags($text);
}

/**
 * Prepares variables for profile full template.
 */
function _portfolio_core_preprocess_profile_full(array &$variables, NodeInterface $node): void {
  /** @var \Drupal\portfolio_core\Service\ProfileDataService $profile_data */
  $profile_data = \Drupal::service('portfolio_core.profile_data');

  $variables['profile_subtitle'] = $node->get('field_subtitle')->value ?? '';
  $variables['profile_location'] = $node->get('field_location')->value ?? '';
  $variables['profile_phone'] = $node->get('field_phone')->value ?? '';
  $variables['profile_email'] = $node->get('field_email')->value ?? '';

  $bio_field = $node->get('field_bio');
  $variables['profile_bio'] = !$bio_field->isEmpty()
    ? check_markup($bio_field->value, $bio_field->format)
    : '';

  $github = $node->get('field_github_url');
  $variables['profile_github_url'] = !$github->isEmpty() ? $github->first()->getUrl()->toString() : '';

  $linkedin = $node->get('field_linkedin_url');
  $variables['profile_linkedin_url'] = !$linkedin->isEmpty() ? $linkedin->first()->getUrl()->toString() : '';

  $drupalorg = $node->get('field_drupalorg_url');
  $variables['profile_drupalorg_url'] = !$drupalorg->isEmpty() ? $drupalorg->first()->getUrl()->toString() : '';

  // Hero.
  $variables['profile_tagline'] = t('Building scalable, accessible Drupal platforms.');
  $variables['profile_specialties'] = [
    t('Drupal 8–11'),
    t('Acquia Cloud & Site Studio'),
    t('Multisite'),
    t('PHP'),
    t('REST APIs'),
  ];
  $years = (int) ($node->get('field_years_experience')->value ?? 0);
  $variables['profile_hero_meta'] = array_filter([
    $years ? t('@count years of experience', ['@count' => $years]) : NULL,
    $variables['profile_location'] ?: NULL,
  ]);
  $variables['profile_cv_url'] = Url::fromRoute('entity_print.view', [
    'export_type' => 'pdf',
    'entity_type' => 'node',
    'entity_id' => $node->id(),
  ])->toString();

  $variables['profile_skills']          = $profile_data->getSkillsByCategory();
  $variables['profile_work_experience'] = $profile_data->getWorkExperience($node);
  $variables['profile_availability']    = $profile_data->getAvailability($node);
  $variables['profile_stats']           = $profile_data->getContentStats($node);

  // Education.
  $variables['profile_edu_degree'] = $node->get('field_edu_degree')->value ?? '';
  $variables['profile_edu_institution'] = $node->get('field_edu_institution')->value ?? '';
  $variables['profile_edu_location'] = $node->get('field_edu_location')->value ?? '';
  $variables['profile_edu_start_year'] = $node->get('field_edu_start_year')->value ?? '';
  $variables['profile_edu_end_year'] = $node->get('field_edu_end_year')->value ?? '';

  // Languages.
  $variables['profile_languages'] = array_map(
    fn($item) => $item->value,
    iterator_to_array($node->get('field_languages')),
  );
}

/**
 * Prepares variables for project full template.
 */
function _portfolio_core_preprocess_project_full(array &$variables, NodeInterface $node): void {
  _portfolio_core_preprocess_project_teaser($variables, $node);

  $date_formatter = \Drupal::service('date.formatter');

  $start = $node->get('field_start_date')->value;
  $variables['project_start_date'] = $start
    ? $date_formatter->format(strtotime($start), 'custom', 'M Y')
    : '';

  $end = $node->get('field_end_date')->value;
  $variables['project_end_date'] = $end
    ? $date_formatter->format(strtotime($end), 'custom', 'M Y')
    : '';
}

/**
 * Prepares variables for profile PDF template.
 */
function _portfolio_core_preprocess_profile_pdf(array &$variables, NodeInterface $node): void {
  /** @var \Drupal\portfolio_core\Service\ProfileDataService $profile_data */
  $profile_data = \Drupal::service('portfolio_core.profile_data');

  // Profile identity.
  $variables['profile_name'] = $node->label();
  $variables['profile_subtitle'] = $node->get('field_subtitle')->value ?? '';
  $variables['profile_location'] = $node->get('field_location')->value ?? '';
  $variables['profile_email'] = $node->get('field_email')->value ?? '';
  $variables['profile_phone'] = $node->get('field_phone')->value ?? '';
  $variables['profile_years_experience'] = $node->get('field_years_experience')->value ?? '';

  // Bio as plain text for the Professional Summary section.
  $bio_field = $node->get('field_bio');
  $variables['profile_bio'] = !$bio_field->isEmpty()
    ? strip_tags((string) check_markup($bio_field->value, $bio_field->format))
    : '';

  // Contact links — pass both URL (for href) and title (for display text).
  $github = $node->get('field_github_url');
  $variables['profile_github_url'] = !$github->isEmpty() ? $github->first()->getUrl()->toString() : '';
  $variables['profile_github_label'] = !$github->isEmpty() ? ($github->first()->title ?: 'GitHub') : '';

  $linkedin = $node->get('field_linkedin_url');
  $variables['profile_linkedin_url'] = !$linkedin->isEmpty() ? $linkedin->first()->getUrl()->toString() : '';
  $variables['profile_linkedin_label'] = !$linkedin->isEmpty() ? ($linkedin->first()->title ?: 'LinkedIn') : '';

  $drupalorg = $node->get('field_drupalorg_url');
  $variables['profile_drupalorg_url'] = !$drupalorg->isEmpty() ? $drupalorg->first()->getUrl()->toString() : '';
  $variables['profile_drupalorg_label'] = !$drupalorg->isEmpty() ? ($drupalorg->first()->title ?: 'Drupal.org') : '';

  $variables['profile_skills']          = $profile_data->getSkillsByCategory();
  $variables['profile_work_experience'] = $profile_data->getWorkExperience($node, includeEmploymentType: TRUE);

  // Education.
  $variables['profile_edu_degree'] = $node->get('field_edu_degree')->value ?? '';
  $variables['profile_edu_institution'] = $node->get('field_edu_institution')->value ?? '';
  $variables['profile_edu_location'] = $node->get('field_edu_location')->value ?? '';
  $variables['profile_edu_start_year'] = $node->get('field_edu_start_year')->value ?? '';
  $variables['profile_edu_end_year'] = $node->get('field_edu_end_year')->value ?? '';

  // Languages — collect all multi-value string items.
  $variables['profile_languages'] = array_map(
    fn($item) => $item->value,
    iterator_to_array($node->get('field_languages')),
  );

  // Tailored CV: an approved plan (set only while CvPdfGenerator renders)
  // replaces the summary, skills order and bullets, and adds highlights.
  $plan = \Drupal::service('portfolio_core.tailored_cv_context')->get();
  if ($plan !== NULL) {
    $variables['profile_bio'] = $plan['summary'];
    $variables['profile_skills'] = $plan['skills'];
    $variables['profile_highlights'] = array_column($plan['highlights'], 'text');
    foreach ($plan['jobs'] as $job) {
      if (isset($variables['profile_work_experience'][$job['index']])) {
        $variables['profile_work_experience'][$job['index']]['achievements'] = array_column(
          array_filter($job['bullets'], fn(array $bullet): bool => $bullet['checked']),
          'text',
        );
      }
    }
    // Never cache a tailored render.
    $variables['#cache']['max-age'] = 0;
  }

  // Entity Print bypasses the standard render cache; explicit cache tags
  // ensure invalidation when the profile node is updated.
  $variables['#cache']['tags'] = array_merge(
    $variables['#cache']['tags'] ?? [],
    $node->getCacheTags(),
  );
}

/**
 * Implements hook_views_post_render().
 */
function portfolio_core_views_post_render(ViewExecutable $view, array &$output, CachePluginBase $cache): void {
  if (!in_array($view->id(), ['portfolio_projects', 'portfolio_skills'], TRUE)) {
    return;
  }
  if (empty($view->result)) {
    return;
  }

  $items = [];
  $position = 1;
  foreach ($view->result as $row) {
    if (!$row->_entity instanceof NodeInterface) {
      continue;
    }
    $node = $row->_entity;

    if ($view->id() === 'portfolio_projects') {
      $stack = array_map(fn($t) => $t->label(), $node->get('field_stack')->referencedEntities());
      $item = array_filter([
        '@type'               => 'SoftwareSourceCode',
        'name'                => $node->label(),
        'url'                 => $node->toUrl()->setAbsolute()->toString(),
        'description'         => $node->get('field_summary')->value ?? '',
        'programmingLanguage' => $stack ?: NULL,
      ]);
    }
    else {
      $item = [
        '@type' => 'DefinedTerm',
        'name'  => $node->label(),
        'url'   => $node->toUrl()->setAbsolute()->toString(),
      ];
    }

    $items[] = [
      '@type'    => 'ListItem',
      'position' => $position++,
      'item'     => $item,
    ];
  }

  $list_name = $view->id() === 'portfolio_projects' ? 'Projects' : 'Skills';
  $key       = 'portfolio-json-ld-' . str_replace('portfolio_', '', $view->id()) . '-list';

  $output['#attached']['html_head'][] = [
    [
      '#type'       => 'html_tag',
      '#tag'        => 'script',
      '#value'      => json_encode(
        [
          '@context'        => 'https://schema.org',
          '@type'           => 'ItemList',
          'name'            => $list_name,
          'itemListElement' => $items,
        ],
        JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_AMP | JSON_HEX_TAG
      ),
      '#attributes' => ['type' => 'application/ld+json'],
    ],
    $key,
  ];
}
