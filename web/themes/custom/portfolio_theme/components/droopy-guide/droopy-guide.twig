<div class="droopy" data-endpoint="{{ endpoint }}" data-sections="{{ sections|json_encode }}" data-cv-url="{{ cv_url }}" data-email="{{ email }}"{% if tailor_url %} data-tailor-url="{{ tailor_url }}"{% endif %}>
  <p class="droopy__bubble" aria-hidden="true"></p>

  <button type="button"
          class="droopy__launcher"
          aria-expanded="false"
          aria-controls="droopy-panel"
          aria-label="{{ 'Ask about Ricardo'|t }}">
    <svg class="droopy__svg" viewBox="0 0 160 190" fill="none" aria-hidden="true" focusable="false">
      <path class="droopy__body" d="M80 14 C58 30, 14 62, 14 112 A66 66 0 0 0 146 112 C146 62, 102 30, 80 14 Z" stroke="currentColor" stroke-width="7" stroke-linejoin="round"/>
      <g class="droopy__eyes">
        <path class="droopy__eye droopy__eye--left" d="M50 100 C48 84, 60 76, 72 82 C84 88, 82 102, 70 108 C58 114, 46 112, 50 100 Z" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
        <path class="droopy__eye droopy__eye--right" d="M110 100 C112 112, 100 118, 88 114 C76 110, 76 96, 88 90 C100 84, 112 88, 110 100 Z" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
      </g>
      <path class="droopy__smile" d="M66 128 Q80 140 94 128" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
    </svg>
    <span class="droopy__zzz" aria-hidden="true"><span>z</span><span>z</span><span>z</span></span>
  </button>

  <section id="droopy-panel" class="droopy__panel" role="dialog" aria-modal="false" aria-labelledby="droopy-title" hidden>
    <header class="droopy__header">
      <h2 class="droopy__title" id="droopy-title">{{ 'Ask about Ricardo'|t }}</h2>
      <div class="droopy__header-actions">
        <button type="button" class="droopy__clear" aria-label="{{ 'Clear conversation'|t }}" title="{{ 'Clear conversation'|t }}" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>
        </button>
        <button type="button" class="droopy__close" aria-label="{{ 'Close'|t }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </header>

    <div class="droopy__log" aria-live="polite">
      <p class="droopy__msg droopy__msg--bot">{{ 'Hi! I\'m Droopy 💧 Ask me anything about Ricardo — his experience, skills or availability.'|t }}</p>
    </div>

    {% if chips %}
      <div class="droopy__chips">
        {% for chip in chips %}
          <button type="button" class="droopy__chip"{{ loop.last ? ' data-mode="fit"' }}>{{ chip }}</button>
        {% endfor %}
      </div>
    {% endif %}

    <form class="droopy__form">
      <div class="droopy__tools">
        <button type="button" class="droopy__fit-toggle" aria-pressed="false" title="{{ 'Paste a job description to check the fit'|t }}">{{ 'Job fit'|t }}</button>
      </div>
      <label class="visually-hidden" for="droopy-input">{{ 'Your question'|t }}</label>
      <textarea id="droopy-input" class="droopy__input" rows="2" maxlength="1000" placeholder="{{ 'Ask about Ricardo…'|t }}"></textarea>
      <button type="submit" class="droopy__send" aria-label="{{ 'Send'|t }}">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg>
      </button>
    </form>

    <p class="droopy__disclaimer">{{ 'AI answers based on Ricardo\'s CV. Don\'t share personal information.'|t }}</p>
  </section>
</div>
