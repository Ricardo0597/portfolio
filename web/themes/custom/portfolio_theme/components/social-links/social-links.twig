{%- set size = size|default('md') -%}
{%- set links = [
  { url: github, label: 'GitHub'|t, icon: 'github' },
  { url: linkedin, label: 'LinkedIn'|t, icon: 'linkedin' },
  { url: drupalorg, label: 'Drupal.org'|t, icon: 'drupal' },
]|filter(l => l.url) -%}
{% if links %}
  <ul class="social-links social-links--{{ size }}">
    {% for link in links %}
      <li class="social-links__item">
        <a href="{{ link.url }}" class="social-links__link" aria-label="{{ link.label }}" title="{{ link.label }}" target="_blank" rel="noopener noreferrer">
          <svg class="social-links__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            {% if link.icon == 'github' %}
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/>
            {% elseif link.icon == 'linkedin' %}
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>
            {% else %}
              <path d="M12 1.5C10.4 3.6 7 6 5.6 8.2A8 8 0 0 0 4 13a8 8 0 0 0 16 0c0-1.8-.6-3.4-1.6-4.8C17 6 13.6 3.6 12 1.5Zm-2.6 16.1a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4Zm5.2 0c-.9 0-1.5-.5-2.2-.5s-1.3.5-2.2.5h-.1a2.6 2.6 0 0 0 2.3-1.3 2.6 2.6 0 0 0 2.3 1.3Zm.9-3.2c-.9 0-2.2-1.4-3.5-1.4-1.6 0-2.6 1.6-4 1.6A1.8 1.8 0 0 1 6.2 13c0-1.6 1.6-2.7 2.9-2.7 1.6 0 2.4 1.5 3.2 1.5.9 0 1.8-1.7 3.2-1.7 1.2 0 2.3 1 2.3 2.3 0 1.1-.9 2-1.8 2Z"/>
            {% endif %}
          </svg>
        </a>
      </li>
    {% endfor %}
  </ul>
{% endif %}
