<article class="about">

  <header class="about__header">
    {% if profile_subtitle %}
      <p class="about__subtitle">{{ profile_subtitle }}</p>
    {% endif %}
    <div class="about__meta">
      {% if profile_location %}
        <span class="about__meta-item">{{ profile_location }}</span>
      {% endif %}
      {% if profile_phone %}
        <span class="about__meta-item">{{ profile_phone }}</span>
      {% endif %}
      {% if profile_email %}
        <a href="mailto:{{ profile_email }}" class="about__meta-item about__meta-item--link">{{ profile_email }}</a>
      {% endif %}
      {% if profile_github_url %}
        <a href="{{ profile_github_url }}" class="about__meta-item about__meta-item--link" target="_blank" rel="noopener noreferrer">GitHub</a>
      {% endif %}
      {% if profile_linkedin_url %}
        <a href="{{ profile_linkedin_url }}" class="about__meta-item about__meta-item--link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      {% endif %}
      {% if profile_drupalorg_url %}
        <a href="{{ profile_drupalorg_url }}" class="about__meta-item about__meta-item--link" target="_blank" rel="noopener noreferrer">Drupal.org</a>
      {% endif %}
    </div>
  </header>

  {% if profile_stats %}
    <div class="stats-strip">
      {% if profile_stats.experience %}
        <div class="stats-strip__item">
          <span class="stats-strip__number" data-count="{{ profile_stats.experience }}">0</span>
          <span class="stats-strip__label">{{ 'Years Experience'|t }}</span>
        </div>
      {% endif %}
      {% if profile_stats.projects %}
        <div class="stats-strip__item">
          <span class="stats-strip__number" data-count="{{ profile_stats.projects }}">0</span>
          <span class="stats-strip__label">{{ 'Projects Shipped'|t }}</span>
        </div>
      {% endif %}
      {% if profile_stats.skills %}
        <div class="stats-strip__item">
          <span class="stats-strip__number" data-count="{{ profile_stats.skills }}">0</span>
          <span class="stats-strip__label">{{ 'Skills'|t }}</span>
        </div>
      {% endif %}
      {% if profile_stats.articles %}
        <div class="stats-strip__item">
          <span class="stats-strip__number" data-count="{{ profile_stats.articles }}">0</span>
          <span class="stats-strip__label">{{ 'Articles Written'|t }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="about__actions">
    <a href="{{ path('entity_print.view', {export_type: 'pdf', entity_type: 'node', entity_id: node.id}) }}"
       class="about__download-btn"
       target="_blank">
      Download CV (PDF)
    </a>
  </div>

  {% if profile_bio %}
    <div class="about__bio">
      {{ profile_bio }}
    </div>
  {% endif %}

  {# ── Core Skills ─────────────────────────────────────────────── #}
  {% if profile_skills %}
    <div class="about__section">
      <h2 class="about__section-title">Core Skills</h2>
      <div class="about__skills">
        {% for category, labels in profile_skills %}
          <div class="about__skills-group">
            <span class="about__skills-category">{{ category }}</span>
            <div class="about__skills-tags">
              {% for label in labels %}
                <span class="about__skill-tag">{{ label }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# ── Work Experience ─────────────────────────────────────────── #}
  {% if profile_work_experience %}
    <div class="about__section about__section--timeline">
      <h2 class="about__section-title">Work Experience</h2>
      {% for job in profile_work_experience %}
        <div class="about__work-item">
          <div class="about__work-header">
            <strong>{{ job.job_title }}</strong>
            {% if job.company %}<span class="about__work-company"> — {{ job.company }}</span>{% endif %}
          </div>
          <div class="about__work-meta">
            {%- set meta_items = [] -%}
            {%- if job.location -%}{%- set meta_items = meta_items|merge([job.location]) -%}{%- endif -%}
            {%- if job.start -%}{%- set meta_items = meta_items|merge([job.start ~ ' – ' ~ job.end]) -%}{%- endif -%}
            {{ meta_items|join(' · ') }}
          </div>
          {% if job.achievements %}
            <ul class="about__achievements">
              {% for bullet in job.achievements %}
                <li class="about__achievement">{{ bullet }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {# ── Education ───────────────────────────────────────────────── #}
  {% if profile_edu_degree or profile_edu_institution %}
    <div class="about__section">
      <h2 class="about__section-title">Education</h2>
      <div class="about__edu-item">
        <div class="about__work-header">
          {% if profile_edu_degree %}<strong>{{ profile_edu_degree }}</strong>{% endif %}
          {% if profile_edu_institution %}<span class="about__work-company"> — {{ profile_edu_institution }}</span>{% endif %}
        </div>
        <div class="about__work-meta">
          {%- set edu_meta = [] -%}
          {%- if profile_edu_location -%}{%- set edu_meta = edu_meta|merge([profile_edu_location]) -%}{%- endif -%}
          {%- if profile_edu_start_year -%}
            {%- set year_range = profile_edu_start_year ~ (profile_edu_end_year ? ' – ' ~ profile_edu_end_year : '') -%}
            {%- set edu_meta = edu_meta|merge([year_range]) -%}
          {%- endif -%}
          {{ edu_meta|join(' · ') }}
        </div>
      </div>
    </div>
  {% endif %}

  {# ── Languages ───────────────────────────────────────────────── #}
  {% if profile_languages %}
    <div class="about__section">
      <h2 class="about__section-title">Languages</h2>
      <ul class="about__languages">
        {% for lang in profile_languages %}
          <li class="about__language">{{ lang }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

</article>
