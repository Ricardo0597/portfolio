<article class="about">

  {# ── Hero ────────────────────────────────────────────────────── #}
  <header class="hero" id="top" aria-label="{{ 'Introduction'|t }}">
    {% if profile_availability.available_from %}
      <p class="hero__badge"><span class="hero__badge-dot" aria-hidden="true"></span>{{ 'Available for work'|t }}</p>
    {% endif %}
    <p class="hero__greeting">{{ 'Hi, I\'m'|t }}</p>
    <h1 class="hero__name">{{ label }}</h1>
    {% if profile_subtitle %}
      <p class="hero__role">{{ profile_subtitle }}</p>
    {% endif %}
    <p class="hero__tagline">{{ profile_tagline }}</p>
    {% if profile_specialties %}
      <p class="hero__specialties">{{ profile_specialties|join(' · ') }}</p>
    {% endif %}
    {% if profile_hero_meta %}
      <p class="hero__meta">{{ profile_hero_meta|join(' · ') }}</p>
    {% endif %}
    <div class="hero__actions">
      <a href="{{ profile_cv_url }}" class="hero__cta" target="_blank">{{ 'Download CV (PDF)'|t }}</a>
      <a href="#contact" class="hero__cta hero__cta--outline">{{ 'Contact'|t }}</a>
    </div>
    {{ include('portfolio_theme:social-links', {
      github: profile_github_url,
      linkedin: profile_linkedin_url,
      drupalorg: profile_drupalorg_url,
      size: 'md',
    }, with_context = false) }}
  </header>

  {# ── About ───────────────────────────────────────────────────── #}
  <section class="about__section" id="about" aria-labelledby="about-title">
    <h2 class="about__section-title" id="about-title">{{ 'About'|t }}</h2>
    {% if profile_stats %}
      <div class="stats-strip">
        {% if profile_stats.experience %}
          <div class="stats-strip__item">
            <span class="stats-strip__number" data-count="{{ profile_stats.experience }}">{{ profile_stats.experience }}</span>
            <span class="stats-strip__label">{{ 'Years Experience'|t }}</span>
          </div>
        {% endif %}
        {% if profile_stats.projects %}
          <div class="stats-strip__item">
            <span class="stats-strip__number" data-count="{{ profile_stats.projects }}">{{ profile_stats.projects }}</span>
            <span class="stats-strip__label">{{ 'Projects Shipped'|t }}</span>
          </div>
        {% endif %}
        {% if profile_stats.skills %}
          <div class="stats-strip__item">
            <span class="stats-strip__number" data-count="{{ profile_stats.skills }}">{{ profile_stats.skills }}</span>
            <span class="stats-strip__label">{{ 'Skills'|t }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}
    {% if profile_bio %}
      <div class="about__bio">
        {{ profile_bio }}
      </div>
    {% endif %}
  </section>

  {# ── Core Skills ─────────────────────────────────────────────── #}
  {% if profile_skills %}
    <section class="about__section" id="skills" aria-labelledby="skills-title">
      <h2 class="about__section-title" id="skills-title">{{ 'Core Skills'|t }}</h2>
      <div class="about__skills">
        {% for category, labels in profile_skills %}
          <div class="about__skills-group">
            <span class="about__skills-category">{{ category }}</span>
            <div class="about__skills-tags">
              {% for skill_label in labels %}
                <span class="about__skill-tag">{{ skill_label }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# ── Work Experience ─────────────────────────────────────────── #}
  {% if profile_work_experience %}
    <section class="about__section" id="experience" aria-labelledby="experience-title">
      <h2 class="about__section-title" id="experience-title">{{ 'Work Experience'|t }}</h2>
      <div class="about__timeline">
        {% for job in profile_work_experience %}
          <div class="about__work-item">
            <div class="about__work-header">
              <strong>{{ job.job_title }}</strong>
              {% if job.company %}<span class="about__work-company"> — {{ job.company }}</span>{% endif %}
            </div>
            <div class="about__work-meta">
              {%- set meta_items = [] -%}
              {%- if job.location -%}{%- set meta_items = meta_items|merge([job.location]) -%}{%- endif -%}
              {%- if job.start -%}{%- set meta_items = meta_items|merge([job.start ~ ' – ' ~ job.end]) -%}{%- endif -%}
              {{ meta_items|join(' · ') }}
            </div>
            {% if job.achievements %}
              <ul class="about__achievements">
                {% for bullet in job.achievements %}
                  <li class="about__achievement">{{ bullet }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# ── Education & Languages ───────────────────────────────────── #}
  {% if profile_edu_degree or profile_edu_institution or profile_languages %}
    <section class="about__section" id="education" aria-labelledby="education-title">
      <h2 class="about__section-title" id="education-title">{{ 'Education'|t }}</h2>
      {% if profile_edu_degree or profile_edu_institution %}
        <div class="about__edu-item">
          <div class="about__work-header">
            {% if profile_edu_degree %}<strong>{{ profile_edu_degree }}</strong>{% endif %}
            {% if profile_edu_institution %}<span class="about__work-company"> — {{ profile_edu_institution }}</span>{% endif %}
          </div>
          <div class="about__work-meta">
            {%- set edu_meta = [] -%}
            {%- if profile_edu_location -%}{%- set edu_meta = edu_meta|merge([profile_edu_location]) -%}{%- endif -%}
            {%- if profile_edu_start_year -%}
              {%- set year_range = profile_edu_start_year ~ (profile_edu_end_year ? ' – ' ~ profile_edu_end_year : '') -%}
              {%- set edu_meta = edu_meta|merge([year_range]) -%}
            {%- endif -%}
            {{ edu_meta|join(' · ') }}
          </div>
        </div>
      {% endif %}
      {% if profile_languages %}
        <h3 class="about__subsection-title">{{ 'Languages'|t }}</h3>
        <ul class="about__languages">
          {% for lang in profile_languages %}
            <li class="about__language">{{ lang }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>
  {% endif %}

  {# ── Contact ─────────────────────────────────────────────────── #}
  <section class="about__section contact" id="contact" aria-labelledby="contact-title">
    <h2 class="about__section-title" id="contact-title">{{ 'Contact'|t }}</h2>
    <p class="contact__lead">{{ 'Open to remote Drupal work.'|t }}</p>
    {% if profile_email %}
      <a href="mailto:{{ profile_email }}" class="contact__email">{{ profile_email }}</a>
    {% endif %}
    <ul class="contact__details">
      {% if profile_phone %}
        <li class="contact__detail">
          <span class="contact__label">{{ 'Phone'|t }}</span>
          <a href="tel:{{ profile_phone|replace({' ': ''}) }}" class="contact__value">{{ profile_phone }}</a>
        </li>
      {% endif %}
      {% set availability = [
        profile_availability.available_from ? 'Available: @when'|t({'@when': profile_availability.available_from}) : null,
        profile_availability.work_mode,
        profile_availability.engagement_types|join(' · '),
        profile_availability.schedule,
      ]|filter(v => v) %}
      {% if availability %}
        <li class="contact__detail contact__detail--wide">
          <span class="contact__label">{{ 'Availability'|t }}</span>
          <span class="contact__value">{{ availability|join(' - ') }}</span>
        </li>
      {% endif %}
      {% if profile_location %}
        <li class="contact__detail">
          <span class="contact__label">{{ 'Location'|t }}</span>
          <span class="contact__value">{{ profile_location }}</span>
        </li>
      {% endif %}
    </ul>
    {{ include('portfolio_theme:social-links', {
      github: profile_github_url,
      linkedin: profile_linkedin_url,
      drupalorg: profile_drupalorg_url,
      size: 'sm',
    }, with_context = false) }}
  </section>

</article>
