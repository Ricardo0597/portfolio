<a href="{{ path('<front>') }}" class="site-branding" rel="home" aria-label="{{ 'Home'|t }}">
  <img class="site-branding__logo"
       src="/{{ directory }}/images/logo.svg"
       alt="{{ 'Site logo'|t }}"
       width="72"
       height="72"
       loading="eager">
  {% if site_name %}
    <span class="site-branding__text">
      <span class="site-branding__name">{{- site_name -}}</span>
      {% if site_slogan %}
        <span class="site-branding__slogan">{{- site_slogan -}}</span>
      {% endif %}
    </span>
  {% endif %}
</a>
