<a href="#main-content" class="skip-link visually-hidden focusable">{{ 'Skip to main content'|t }}</a>

<header role="banner" class="site-header">
  <div class="layout-container site-header__inner">
    {{ page.header }}
    {% if section_nav %}
      <nav id="site-nav" class="site-nav" aria-label="{{ 'Main navigation'|t }}">
        <ul class="site-nav__list">
          {% for item in section_nav %}
            <li class="site-nav__item{{ item.separated ? ' site-nav__item--separated' }}">
              <a href="{{ item.url }}" class="site-nav__link">{{ item.label }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
    <button class="nav-toggle"
            type="button"
            aria-label="{{ 'Open navigation'|t }}"
            aria-expanded="false"
            aria-controls="site-nav">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
    <button class="theme-toggle"
            type="button"
            aria-label="{{ 'Toggle theme'|t }}"
            aria-live="polite">🌙</button>
  </div>
</header>
