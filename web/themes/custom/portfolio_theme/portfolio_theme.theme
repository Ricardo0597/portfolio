<?php
declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the portfolio_theme theme.
 */

use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_page().
 */
function portfolio_theme_preprocess_page(array &$variables): void {
  $variables['logo'] = theme_get_setting('logo.url');

  // Attach Prism syntax highlighting only on pages that have code snippets.
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface && $node->hasField('field_content')) {
    foreach ($node->get('field_content')->referencedEntities() as $paragraph) {
      if ($paragraph->bundle() === 'code_snippet') {
        $variables['#attached']['library'][] = 'portfolio_theme/syntax-highlight';
        break;
      }
    }
  }

  // Header navigation: anchors into the single-page profile, plus the
  // separate headless showcase app. On the front page the links are bare
  // fragments so "/?utm_source=…" scrolls instead of reloading.
  $is_front = \Drupal::service('path.matcher')->isFrontPage();
  $section = static fn(string $id): string => $is_front
    ? '#' . $id
    : Url::fromRoute('<front>', [], ['fragment' => $id])->toString();
  $variables['section_nav'] = [
    ['label' => t('About'), 'url' => $section('about')],
    ['label' => t('Skills'), 'url' => $section('skills')],
    ['label' => t('Experience'), 'url' => $section('experience')],
    ['label' => t('Education'), 'url' => $section('education')],
    ['label' => t('Contact'), 'url' => $section('contact')],
    ['label' => t('Headless'), 'url' => Url::fromUserInput('/headless')->toString(), 'separated' => TRUE],
  ];
  $variables['#cache']['contexts'][] = 'url.path.is_front';
}
