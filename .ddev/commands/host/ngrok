#!/usr/bin/env bash
## Description: Expose the site publicly via ngrok tunnel
## Usage: ngrok
## Example: ddev ngrok

set -e

NGROK_BIN="${NGROK_BIN:-ngrok}"

# Fall back to the downloaded binary location
if ! command -v "$NGROK_BIN" &>/dev/null; then
  if [ -x "/tmp/ngrok" ]; then
    NGROK_BIN="/tmp/ngrok"
  else
    echo "ngrok not found. Download it from https://ngrok.com/download and place it in your PATH."
    exit 1
  fi
fi

PROJECT_URL="https://${DDEV_HOSTNAME}"

# Kill any existing ngrok process for this project
pkill -f "ngrok http.*${DDEV_HOSTNAME}" 2>/dev/null || true
sleep 1

echo "Starting ngrok tunnel for ${PROJECT_URL} ..."
"$NGROK_BIN" http "$PROJECT_URL" --host-header="$DDEV_HOSTNAME" --log=stdout > /tmp/ngrok-"${DDEV_SITENAME}".log 2>&1 &

# Wait for tunnel to be ready
for i in $(seq 1 10); do
  sleep 1
  PUBLIC_URL=$(curl -s http://localhost:4040/api/tunnels 2>/dev/null \
    | python3 -c "import sys,json; d=json.load(sys.stdin); urls=[t['public_url'] for t in d.get('tunnels',[]) if t['public_url'].startswith('https')]; print(urls[0] if urls else '')" 2>/dev/null)
  if [ -n "$PUBLIC_URL" ]; then
    break
  fi
done

if [ -z "$PUBLIC_URL" ]; then
  echo "Failed to get ngrok URL. Check /tmp/ngrok-${DDEV_SITENAME}.log for details."
  exit 1
fi

echo ""
echo "  Public URL: ${PUBLIC_URL}"
echo ""
echo "  Tunnel is running in the background."
echo "  To stop it: pkill -f 'ngrok http'"
