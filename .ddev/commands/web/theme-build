#!/usr/bin/env bash
## Description: Compile SCSS and rebuild Drupal theme caches
## Usage: theme-build
## Example: ddev theme-build

set -e

THEME_DIR=/var/www/html/web/themes/custom/portfolio_theme

echo "Installing theme dependencies..."
npm install --prefix "$THEME_DIR" --silent

echo "Compiling SCSS..."
npm run build --prefix "$THEME_DIR"

echo "Rebuilding Drupal caches..."
cd /var/www/html && drush cr

echo "Done. Theme live at https://portfolio.ddev.site"
