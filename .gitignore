# Worktrees
.worktrees/

# Drupal managed by Composer - do not commit
web/core/
web/modules/contrib/
web/themes/contrib/
web/profiles/contrib/
web/libraries/
vendor/

# Drupal generated/sensitive files
web/sites/default/settings.php
web/sites/default/files/
web/sites/*/settings*.php

# Drupal scaffold files (managed by composer/drupal-scaffold)
web/autoload.php
web/.htaccess
web/index.php
web/update.php
web/robots.txt
web/INSTALL.txt
web/README.md
web/.csslintrc
web/.eslintignore
web/.eslintrc.json
web/.ht.router.php
web/example.gitignore
web/modules/README.txt
web/themes/README.txt
web/profiles/

# Composer
vendor/

# Theme build
web/themes/custom/portfolio_theme/node_modules/
web/themes/custom/portfolio_theme/css/*.map
web/themes/custom/portfolio_theme/components/**/*.map

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
